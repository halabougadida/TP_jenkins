
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {

        // 1. CHECKOUT
        stage('Checkout') {
            steps {
                echo '=== Checkout: Recuperation du code ==='
                checkout scm
                bat 'git status'
                bat 'dir'
            }
        }

        // 2. BUILD
        stage('Build') {
            steps {
                echo '=== Build: Preparation du projet ==='

                bat '''
                    if not exist index.html exit /b 1
                    if not exist index.css exit /b 1
                '''

                bat 'powershell -NoProfile -Command "Compress-Archive -Path index.html,index.css -DestinationPath website.zip -Force"'
            }
        }

        // 3. TEST
        stage('Test') {
            steps {
                echo '=== Test: Verification du projet ==='

                bat 'findstr /i /c:"<html" index.html >nul'
                bat 'if errorlevel 1 exit /b 1'

                bat 'findstr /i /c:"<body" index.html >nul'
                bat 'if errorlevel 1 exit /b 1'

                echo 'Tous les tests sont reussis !'
            }
        }

        // 4. DELIVERY
        stage('Delivery') {
            steps {
                echo '=== Delivery: Livraison du projet ==='

                archiveArtifacts artifacts: 'website.zip,index.html,index.css',
                                 fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'PIPELINE SUCCESS!'
        }

        failure {
            echo 'PIPELINE FAILED!'
        }
    }
}
